# Credentials: never commit a password (pgpass.conf lives in %APPDATA%, not here)
.env
*.pgpass
pgpass.conf

# Office lock / temp files (created while a workbook is open)
~$*
*.tmp

# Power BI: the report is a .pbip project. Commit its text files, not the
# imported-data cache or per-user settings (Refresh in Desktop rebuilds the cache)
**/.pbi/localSettings.json
**/.pbi/cache.abf
# Local safety copies made before model edits through the MCP server
powerbi/backup/

# Editor and OS clutter
.vscode/
Thumbs.db
desktop.ini
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# MCP server registration: machine-specific path to the Power BI Modeling MCP server
.mcp.json
