{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "heatmap-matrix",
  "position": {
    "x": 40,
    "y": 130,
    "z": 2,
    "height": 930,
    "width": 1840,
    "tabOrder": 2
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_feature"
                    }
                  },
                  "Property": "feature_name"
                }
              },
              "queryRef": "dim_feature.feature_name",
              "nativeQueryRef": "feature_name",
              "displayName": "Finding",
              "active": true
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_disease"
                    }
                  },
                  "Property": "disease_name"
                }
              },
              "queryRef": "dim_disease.disease_name",
              "nativeQueryRef": "disease_name",
              "displayName": "Disease",
              "active": true
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Signature Strength (pts)"
                }
              },
              "queryRef": "_Measures.Signature Strength (pts)",
              "nativeQueryRef": "Signature Strength (pts)"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "dim_feature"
                  }
                },
                "Property": "feature_name"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "objects": {
      "grid": [
        {
          "properties": {
            "rowPadding": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ],
      "subTotals": [
        {
          "properties": {
            "rowSubtotals": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "columnSubtotals": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "values": [
        {
          "properties": {
            "backColor": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "_Measures"
                            }
                          },
                          "Property": "Signature Strength (pts)"
                        }
                      },
                      "FillRule": {
                        "linearGradient3": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#D64550'"
                              }
                            }
                          },
                          "mid": {
                            "color": {
                              "Literal": {
                                "Value": "'#FFFFFF'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "0D"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#2E9E5B'"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'asZero'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "_Measures.Signature Strength (pts)"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Signature strength (pts) by finding and disease'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}