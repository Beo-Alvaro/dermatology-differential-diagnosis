{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "pairs-scatter",
  "position": {
    "x": 40,
    "y": 300,
    "z": 4,
    "height": 750,
    "width": 900,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "vw_q3_pair_feature_gaps"
                    }
                  },
                  "Property": "pair_label"
                }
              },
              "queryRef": "vw_q3_pair_feature_gaps.pair_label",
              "nativeQueryRef": "pair_label",
              "active": true,
              "displayName": "Pair"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sharp Clinical Share"
                }
              },
              "queryRef": "_Measures.Sharp Clinical Share",
              "nativeQueryRef": "Sharp Clinical Share",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sharp Histo Share"
                }
              },
              "queryRef": "_Measures.Sharp Histo Share",
              "nativeQueryRef": "Sharp Histo Share"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryLabels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "start": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "end": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "start": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "end": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Clinical vs biopsy separability, one dot per pair'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}