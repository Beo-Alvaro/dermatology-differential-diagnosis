{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "explorer-title",
  "position": {
    "x": 40,
    "y": 20,
    "z": 0,
    "height": 110,
    "width": 1440,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Which findings point to one disease? Who is atypical?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "20pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Bars: which diseases the patients with each finding have, counting a finding when its score is at least k. A red flag is a finding where one disease is at least 80% of those patients (with at least 10 patients). Atypical = missing at least one of the disease's top 3 signature findings.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
